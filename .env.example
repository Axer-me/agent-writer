# OpenRouter (только модели *:free — на балансе нет денег)
OPEN_ROUTER_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free

# GigaChat (главы). Ключ из кабинета Сбера — как GIGACHAT_API_KEY или GIGACHAT_CREDENTIALS
GIGACHAT_API_KEY=
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Новый адрес нужен для Ultra. На Windows без этой строки рукопожатие обрывается.
GIGACHAT_VERIFY_SSL=false
GIGACHAT_BASE_URL=https://api.giga.chat/v1
