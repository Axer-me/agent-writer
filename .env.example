# OpenRouter (только модели *:free — на балансе нет денег)
OPEN_ROUTER_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free

# GigaChat (главы). Ключ из кабинета Сбера — как GIGACHAT_API_KEY или GIGACHAT_CREDENTIALS
GIGACHAT_API_KEY=
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# Если на Windows ошибка сертификата Сбера — раскомментируйте:
# GIGACHAT_VERIFY_SSL=false
